  {
    "name": "Social & SEO",
    "settings": [
      {
        "type": "image_picker",
        "id": "og_image",
        "label": "Default social share image (OG image)"
      },
      {
        "type": "text",
        "id": "whatsapp_url",
        "label": "WhatsApp link",

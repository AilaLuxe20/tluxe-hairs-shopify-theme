      },
      {
        "type": "text",
        "id": "instagram_url",
        "label": "Instagram URL",
        "info": "Full https URL. Leave blank to hide the icon.",
        "default": "https://www.instagram.com/tluxe_hairs"
      },
      {
        "type": "text",
        "id": "tiktok_url",
        "label": "TikTok URL",
        "info": "Full https URL. Leave blank to hide the icon.",
        "default": "https://www.tiktok.com/@tluxe_hairs"
      },
      {
        "type": "text",
        "id": "facebook_url",
        "label": "Facebook URL",
        "info": "Full https URL. Leave blank to hide the icon.",
        "default": "https://www.facebook.com/share/17vAo8ZAe8/?mibextid=wwXIfr"
      },
      {
        "type": "text",
        "id": "snapchat_url",
        "label": "Snapchat URL",
        "info": "Full https URL. Leave blank to hide the icon. Confirm this is the business account before leaving it public."
      },
      {
        "type": "checkbox",
        "id": "show_paypal_hosted_button",
        "label": "Show PayPal Hosted Button on product pages",

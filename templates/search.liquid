{% comment %} Shopify-native search {% endcomment %}
<div style="padding-top:120px;min-height:60vh;">
  <div class="container">
    <div style="text-align:center;margin-bottom:48px;">
      <p class="eyebrow">Find Your Piece</p>
      <h1 style="font-family:var(--font-display);font-size:clamp(2rem,4vw,3rem);font-weight:300;margin:12px 0;">Search</h1>
      <div class="gold-line"></div>
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search" style="max-width:560px;margin:0 auto 48px;">
      <label class="visually-hidden" for="tluxe-search-q">Search products</label>
      <div style="display:flex;gap:8px;">
        <input
          id="tluxe-search-q"
          class="form-input"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="Search wigs, length, colour…"
          autocomplete="off"
        >
        <input type="hidden" name="type" value="product">
        <button type="submit" class="btn btn-gold" style="flex-shrink:0;">Search</button>
      </div>
    </form>

    {% if search.performed %}
      {% paginate search.results by 24 %}
        {% if search.results_count == 0 %}
          <p style="text-align:center;color:var(--cream-dim);">No products matched “{{ search.terms | escape }}”.</p>
        {% else %}
          <p style="text-align:center;color:var(--cream-dim);margin-bottom:32px;font-size:0.78rem;letter-spacing:0.1em;text-transform:uppercase;">
            {{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %}
          </p>
          <div class="product-grid">
            {% for item in search.results %}
              {% if item.object_type == 'product' %}
                {% render 'product-card', product: item %}
              {% endif %}
            {% endfor %}
          </div>
          {% if paginate.pages > 1 %}
            <div style="text-align:center;margin-top:64px;">{{ paginate | default_pagination }}</div>
          {% endif %}
        {% endif %}
      {% endpaginate %}
    {% endif %}
  </div>
</div>

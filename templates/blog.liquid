{% render 'page-hero', heading: blog.title, eyebrow: 'From The Journal', subheading: 'Expert tips and guides for your luxury hair', hero_image: settings.banner_blog %}


{% paginate blog.articles by 9 %}
<div class="container" style="padding-top:120px;padding-bottom:80px;">
  <div class="section-header" data-reveal>
    <p class="eyebrow">Latest Posts</p>
    <h1>{{ blog.title }}</h1>
    <div class="gold-line"></div>
  </div>

  <div class="product-grid">
    {% for article in blog.articles %}
    <article style="background:var(--black-card);border:1px solid var(--black-border);border-radius:2px;overflow:hidden;">
      <a href="{{ article.url }}">
        {% if article.image %}
          <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.image.alt | escape }}" width="600" height="338" style="width:100%;aspect-ratio:16/9;object-fit:cover;" loading="lazy">
        {% else %}
          <div style="width:100%;aspect-ratio:16/9;background:linear-gradient(135deg,var(--black-soft),var(--black-card));display:flex;align-items:center;justify-content:center;">
            <svg width="48" height="48" fill="none" stroke="var(--gold)" stroke-width="1" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </div>
        {% endif %}
      </a>
      <div style="padding:20px;">
        <p class="eyebrow" style="margin-bottom:8px;">{{ article.published_at | date: "%B %d, %Y" }}</p>
        <h3 style="font-size:1.1rem;margin-bottom:12px;">
          <a href="{{ article.url }}" style="color:var(--cream);">{{ article.title }}</a>
        </h3>
        <p style="color:var(--cream-dim);font-size:0.85rem;line-height:1.7;margin-bottom:16px;">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
        <a href="{{ article.url }}" style="font-size:0.7rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--gold);">Read More →</a>
      </div>
    </article>
    {% endfor %}
  </div>

  {% if paginate.pages > 1 %}
  <div style="text-align:center;margin-top:48px;">
    {{ paginate | default_pagination }}
  </div>
  {% endif %}
</div>
{% endpaginate %}

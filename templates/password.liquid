<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }}</title>
  {{ 'tluxe.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <main class="container" style="min-height:100vh;display:flex;align-items:center;justify-content:center;text-align:center;">
    <div style="max-width:420px;">
      <h1 style="font-family:var(--font-display);font-size:2rem;font-weight:300;margin-bottom:16px;">{{ shop.name }}</h1>
      <p style="color:var(--cream-dim);margin-bottom:28px;">This shop is opening soon.</p>
      {% form 'storefront_password' %}
        <label class="visually-hidden" for="password">Password</label>
        <input id="password" class="form-input" type="password" name="password" autocomplete="current-password">
        <button type="submit" class="btn btn-gold" style="margin-top:16px;width:100%;justify-content:center;">Enter</button>
      {% endform %}
    </div>
  </main>
</body>
</html>

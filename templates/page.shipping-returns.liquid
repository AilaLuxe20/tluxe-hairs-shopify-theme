{% comment %} Shipping and Returns page {% endcomment %}

<div style="padding-top:120px;min-height:60vh;">
  <div class="container">
    <div style="text-align:center;margin-bottom:64px;">
      <p class="eyebrow">Policies</p>
      <h1 style="font-family:var(--font-display);font-size:clamp(2rem,4vw,3.5rem);font-weight:300;margin:12px 0;">Shipping &amp; Returns</h1>
      <div class="gold-line"></div>
    </div>

    <div style="max-width:760px;margin:0 auto;display:flex;flex-direction:column;gap:48px;">

      <div data-reveal>
        <h2 style="font-family:var(--font-display);font-size:1.8rem;font-weight:400;color:var(--gold);margin-bottom:20px;">Shipping Policy</h2>
        <div class="gold-line-left"></div>
        <div style="margin-top:24px;display:flex;flex-direction:column;gap:20px;">
          <div style="padding:24px;background:var(--black-card);border:1px solid var(--black-border);border-radius:2px;">
            <div style="font-size:0.65rem;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--gold);margin-bottom:10px;">Lagos Delivery</div>
            <p style="color:var(--cream-dim);line-height:1.8;font-size:0.9rem;">Shipping is calculated at checkout. There is currently no free-shipping threshold. Current Nigeria checkout rates in Shopify: Standard ₦25,000, Economy ₦40,000, Express ₦55,000.</p>
          </div>
          <div style="padding:24px;background:var(--black-card);border:1px solid var(--black-border);border-radius:2px;">
            <div style="font-size:0.65rem;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--gold);margin-bottom:10px;">Nationwide Delivery</div>
            <p style="color:var(--cream-dim);line-height:1.8;font-size:0.9rem;">3 to 7 business days to all states in Nigeria. Delivered via trusted courier partners.</p>
          </div>
          <div style="padding:24px;background:var(--black-card);border:1px solid var(--black-border);border-radius:2px;">
            <div style="font-size:0.65rem;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--gold);margin-bottom:10px;">International Shipping</div>
            <p style="color:var(--cream-dim);line-height:1.8;font-size:0.9rem;">Shipping cost and delivery window are calculated at checkout from the destination address. Current international checkout rates in Shopify: Standard ₦45,000, Economy ₦55,000, Express ₦75,000.</p>
          </div>
          <div style="padding:24px;background:var(--black-card);border:1px solid var(--black-border);border-radius:2px;">
            <div style="font-size:0.65rem;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--gold);margin-bottom:10px;">Order Processing</div>
            <p style="color:var(--cream-dim);line-height:1.8;font-size:0.9rem;">All orders are processed within 1 to 2 business days. You will receive a tracking number once your order is dispatched. Orders placed on weekends or public holidays are processed the next business day.</p>
          </div>
        </div>
      </div>

      <div data-reveal>
        <h2 style="font-family:var(--font-display);font-size:1.8rem;font-weight:400;color:var(--gold);margin-bottom:20px;">Returns Policy</h2>
        <div class="gold-line-left"></div>
        <div style="margin-top:24px;display:flex;flex-direction:column;gap:20px;">
          <div style="padding:24px;background:var(--black-card);border:1px solid var(--black-border);border-radius:2px;">
            <div style="font-size:0.65rem;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--gold);margin-bottom:10px;">Eligibility</div>
            <p style="color:var(--cream-dim);line-height:1.8;font-size:0.9rem;">We accept returns on unworn, unaltered, and undamaged items within 7 days of delivery. The hair must be in its original packaging, with no combing, brushing, dyeing, or heat application.</p>
          </div>
          <div style="padding:24px;background:var(--black-card);border:1px solid var(--black-border);border-radius:2px;">
            <div style="font-size:0.65rem;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--gold);margin-bottom:10px;">Non-Returnable Items</div>
            <p style="color:var(--cream-dim);line-height:1.8;font-size:0.9rem;">Hair that has been installed, washed, dyed, bleached, permed, heat-styled, or otherwise altered cannot be returned. Custom colour orders are also final sale.</p>
          </div>
          <div style="padding:24px;background:var(--black-card);border:1px solid var(--black-border);border-radius:2px;">
            <div style="font-size:0.65rem;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--gold);margin-bottom:10px;">How to Return</div>
            <p style="color:var(--cream-dim);line-height:1.8;font-size:0.9rem;">Contact us via WhatsApp within 7 days of receiving your order. Include your order number and photos of the item. We will guide you through the return process and arrange collection or provide a return address.</p>
          </div>
          <div style="padding:24px;background:var(--black-card);border:1px solid var(--black-border);border-radius:2px;">
            <div style="font-size:0.65rem;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--gold);margin-bottom:10px;">Refunds</div>
            <p style="color:var(--cream-dim);line-height:1.8;font-size:0.9rem;">Once we receive and inspect your return, we will process a refund to your original payment method within 5 to 10 business days. Return shipping costs are the responsibility of the customer unless the item was defective or incorrect.</p>
          </div>
        </div>
      </div>

      <div style="text-align:center;padding:40px;background:var(--black-card);border:1px solid var(--black-border);border-radius:2px;" data-reveal>
        <p style="color:var(--cream-dim);margin-bottom:20px;font-size:0.9rem;">Have a question about your order?</p>
        <a href="{% render 'whatsapp-url' %}" class="btn btn-gold" target="_blank" rel="noopener">Chat with Us on WhatsApp</a>
      </div>

    </div>
  </div>
</div>

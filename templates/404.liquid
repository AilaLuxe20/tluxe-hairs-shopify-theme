{% comment %} 404 page {% endcomment %}
<div style="padding-top:120px;min-height:60vh;display:flex;align-items:center;">
  <div class="container" style="text-align:center;">
    <p style="font-family:var(--font-display);font-size:8rem;font-weight:300;color:var(--gold);line-height:1;opacity:0.3;">404</p>
    <h1 style="font-family:var(--font-display);font-size:clamp(2rem,4vw,3rem);font-weight:300;margin:16px 0;">Page Not Found</h1>
    <div class="gold-line"></div>
    <p style="color:var(--cream-dim);margin:20px auto 36px;max-width:400px;">The page you are looking for has moved or does not exist. Let us help you find what you need.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <a href="{{ routes.root_url }}" class="btn btn-gold">Go Home</a>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn-outline">Shop All</a>
    </div>
  </div>
</div>

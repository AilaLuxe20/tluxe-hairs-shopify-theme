{% comment %} Cart page {% endcomment %}
<div style="padding-top:120px;min-height:60vh;">
  <div class="container">
    <div style="text-align:center;margin-bottom:48px;">
      <p class="eyebrow">Review Your Order</p>
      <h1 style="font-family:var(--font-display);font-size:clamp(2rem,4vw,3rem);font-weight:300;margin:12px 0;">Your Bag</h1>
      <div class="gold-line"></div>
    </div>

    {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" novalidate class="cart-page-form">

      {% for item in cart.items %}
      <div class="cart-page-row">
        <a href="{{ item.url }}" class="cart-page-img">
          {% if item.image %}
            <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.product.title | escape }}" width="200" height="267" loading="lazy">
          {% endif %}
        </a>
        <div class="cart-page-details">
          <a href="{{ item.url }}" class="cart-page-title">{{ item.product.title | escape }}</a>
          {% unless item.variant.title == 'Default Title' %}
          <div class="cart-page-variant">{{ item.variant.title | escape }}</div>
          {% endunless %}
          <div class="cart-page-meta">
            <div class="cart-page-price">{{ item.line_price | money }}</div>
            <label class="visually-hidden" for="updates_{{ item.key }}">Quantity for {{ item.product.title | escape }}</label>
            <input type="number" name="updates[{{ item.key }}]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0" class="cart-page-qty">
          </div>
          <a href="{{ item.url_to_remove }}" class="cart-page-remove">Remove</a>
        </div>
      </div>
      {% endfor %}

      <div class="cart-page-summary">
        <div class="cart-page-subtotal">
          <span>Subtotal</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p class="cart-page-note">Shipping and taxes calculated at checkout</p>
        <button type="submit" name="checkout" class="btn-atc" style="border:none;">Proceed to Checkout</button>
        <div style="margin-top:12px;">
          <button type="submit" name="update" class="btn btn-ghost cart-page-update">Update Cart</button>
        </div>
        <div style="margin-top:16px;text-align:center;">
          <a href="{{ routes.all_products_collection_url }}" class="cart-page-continue">Continue shopping</a>
        </div>
      </div>
    </form>

    {% else %}
    <div style="text-align:center;padding:60px 0;">
      <svg width="56" height="56" fill="none" stroke="var(--gold)" stroke-width="1" viewBox="0 0 24 24" style="margin:0 auto 24px;opacity:0.4;" aria-hidden="true"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
      <h2 style="font-family:var(--font-display);font-size:2rem;font-weight:300;margin-bottom:16px;">Your bag is empty</h2>
      <p style="color:var(--cream-dim);margin-bottom:32px;">Discover our premium collection and fill your bag with luxury.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn-gold">Shop Now</a>
    </div>
    {% endif %}
  </div>
</div>

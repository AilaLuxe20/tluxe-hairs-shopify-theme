{% comment %} Contact page {% endcomment %}

<div style="padding-top:120px;min-height:60vh;">
  <div class="container">
    <div style="text-align:center;margin-bottom:64px;">
      <p class="eyebrow">Get in Touch</p>
      <h1 style="font-family:var(--font-display);font-size:clamp(2rem,4vw,3.5rem);font-weight:300;margin:12px 0;">Contact Us</h1>
      <div class="gold-line"></div>
      <p style="color:var(--cream-dim);margin-top:16px;">We would love to hear from you. Reach us on WhatsApp for the fastest response.</p>
    </div>

    <div style="display:grid;grid-template-columns:1fr;gap:48px;max-width:900px;margin:0 auto;">

      <!-- Contact Options -->
      <div class="contact-channel-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:20px;" data-reveal>
        <a href="{% render 'whatsapp-url' %}" target="_blank" rel="noopener" class="contact-channel-card contact-wa-card" style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:36px 24px;background:var(--black-card);border:1px solid var(--black-border);border-radius:2px;text-align:center;text-decoration:none;">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="#25D366" style="margin-bottom:16px;" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.122 1.532 5.859L.057 23.514a.75.75 0 00.921.921l5.655-1.475A11.943 11.943 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.943 0-3.772-.502-5.365-1.383l-.386-.22-3.989 1.04 1.041-3.988-.22-.386A9.944 9.944 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
          <div style="font-size:0.65rem;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--gold);margin-bottom:8px;">WhatsApp</div>
          {% if settings.whatsapp_display_label != blank %}
            <div style="color:var(--cream-dim);font-size:0.82rem;">{{ settings.whatsapp_display_label | escape }}</div>
          {% else %}
            <div style="color:var(--cream-dim);font-size:0.82rem;">Chat with TLUXE</div>
          {% endif %}
          <div style="color:var(--cream-dim);font-size:0.72rem;margin-top:6px;">Fastest response</div>
        </a>

        <a href="mailto:tluxehairsenterprises@gmail.com" class="contact-channel-card" style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:36px 24px;background:var(--black-card);border:1px solid var(--black-border);border-radius:2px;text-align:center;text-decoration:none;">
          <svg width="32" height="32" fill="none" stroke="var(--gold)" stroke-width="1.5" viewBox="0 0 24 24" style="margin-bottom:16px;"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <div style="font-size:0.65rem;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--gold);margin-bottom:8px;">Email</div>
          <div style="color:var(--cream-dim);font-size:0.78rem;word-break:break-all;">tluxehairsenterprises<br>@gmail.com</div>
        </a>
      </div>

      <!-- Contact Form -->
      <div data-reveal>
        {% form 'contact' %}
          {% if form.posted_successfully? %}
          <div style="background:rgba(76,175,130,0.1);border:1px solid #4caf82;padding:20px;border-radius:2px;margin-bottom:24px;color:#4caf82;font-size:0.85rem;">
            Thank you for reaching out. We will get back to you within 24 hours.
          </div>
          {% endif %}

          <div class="form-group">
            <label for="contact-name" class="form-label">Full Name</label>
            <input id="contact-name" class="form-input" type="text" name="contact[name]" autocomplete="name" placeholder="Your full name" required>
          </div>
          <div class="form-group">
            <label for="contact-email" class="form-label">Email Address</label>
            <input id="contact-email" class="form-input" type="email" name="contact[email]" autocomplete="email" placeholder="your@email.com" required>
          </div>
          <div class="form-group">
            <label for="contact-subject" class="form-label">Subject</label>
            <input id="contact-subject" class="form-input" type="text" name="contact[subject]" placeholder="How can we help?">
          </div>
          <div class="form-group">
            <label for="contact-body" class="form-label">Message</label>
            <textarea id="contact-body" class="form-textarea" name="contact[body]" placeholder="Tell us more..." required></textarea>
          </div>
          <button type="submit" class="btn btn-gold" style="width:100%;justify-content:center;">Send Message</button>
        {% endform %}
      </div>

    </div>
  </div>
</div>

<style>
.contact-channel-card {
  transition: border-color 0.25s, transform 0.25s;
}
.contact-channel-card:hover {
  border-color: var(--gold) !important;
  transform: translateY(-2px);
}
@media (max-width: 600px) {
  .contact-channel-grid {
    grid-template-columns: 1fr !important;
  }
}
</style>

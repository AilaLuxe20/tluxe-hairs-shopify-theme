{% render 'page-hero', heading: collection.title, eyebrow: 'Shop', subheading: collection.description, hero_image: settings.banner_collections %}


{% comment %} Collection page {% endcomment %}

<div style="padding-top:40px;min-height:60vh;">
  <div class="container">

    <!-- Filter bar -->
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:32px;flex-wrap:wrap;gap:12px;">
      <span style="font-size:0.72rem;color:var(--cream-dim);letter-spacing:0.1em;">{{ collection.products_count }} Products</span>
      <div style="display:flex;gap:8px;">
        {% assign current_sort = collection.sort_by | default: collection.default_sort_by %}
        <form method="get" action="{{ collection.url }}">
          <label class="visually-hidden" for="collection-sort">Sort by</label>
          <select id="collection-sort" name="sort_by" data-auto-submit class="collection-sort">
            <option value="manual"{% if current_sort == 'manual' %} selected{% endif %}>Featured</option>
            <option value="price-ascending"{% if current_sort == 'price-ascending' %} selected{% endif %}>Price: Low to High</option>
            <option value="price-descending"{% if current_sort == 'price-descending' %} selected{% endif %}>Price: High to Low</option>
            <option value="created-descending"{% if current_sort == 'created-descending' %} selected{% endif %}>Newest</option>
            <option value="best-selling"{% if current_sort == 'best-selling' %} selected{% endif %}>Best Selling</option>
          </select>
          <noscript><button type="submit" class="btn btn-ghost">Sort</button></noscript>
        </form>
      </div>
    </div>

    <!-- Grid -->
    {% paginate collection.products by 24 %}
      {% if collection.products.size > 0 %}
      <div class="product-grid">
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
      <div style="text-align:center;margin-top:64px;">
        {{ paginate | default_pagination }}
      </div>
      {% endif %}

      {% else %}
      <div style="text-align:center;padding:80px 0;">
        <p style="color:var(--cream-dim);margin-bottom:24px;">No products found in this collection yet.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn-outline">View All Products</a>
      </div>
      {% endif %}
    {% endpaginate %}

  </div>
</div>
